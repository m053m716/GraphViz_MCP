digraph graphviz_mcp_workflow {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad=0.25,
    nodesep=0.35,
    ranksep=0.65,
    fontname="Segoe UI",
    labelloc=t,
    label="GraphViz MCP workflow\n(icon handshake through bounded rendering to GitHub documentation)",
    fontsize=17,
    color="#cbd5e1"
  ]
  node [
    shape=box,
    style="rounded,filled",
    fontname="Segoe UI",
    fontsize=10,
    color="#1f2937",
    fillcolor="#ecfeff",
    margin="0.16,0.10"
  ]
  edge [
    fontname="Segoe UI",
    fontsize=9,
    color="#475569",
    arrowsize=0.7
  ]

  client [
    label="MCP client\nconnects over STDIO",
    shape=oval,
    fillcolor="#dbeafe",
    mcp_group="Startup"
  ]
  server [
    label="FastMCP(\"graphviz\",\nicons=_mcp_icons())",
    fillcolor="#e0f2fe",
    mcp_group="Startup"
  ]
  handshake [
    label="initialize handshake\nserver name + instructions\n96x96 PNG data URI",
    fillcolor="#e0f2fe",
    mcp_group="Startup"
  ]
  request [
    label="Agent requests\na technical diagram",
    fillcolor="#dbeafe",
    mcp_group="Request"
  ]
  source [
    label="Complete .dot source\n(existing or authored)",
    fillcolor="#dbeafe",
    mcp_group="Request"
  ]
  entry [
    label="MCP entry points\ngraphviz_validate()\ngraphviz_render_source()",
    fillcolor="#e0f2fe",
    mcp_group="MCP entry"
  ]
  render [
    label="Shared render path\ngraphviz_render() / graphviz_sync()\ngraphviz_render_impl()",
    fillcolor="#e0f2fe",
    mcp_group="MCP entry"
  ]
  bounds [
    label="Within 5 rows,\n5 columns, 25 nodes?",
    shape=diamond,
    fillcolor="#fef3c7",
    mcp_group="Layout"
  ]
  direct [
    label="Standard GraphViz\nengine render",
    fillcolor="#dcfce7",
    mcp_group="Layout"
  ]
  reflow [
    label="_render_bounded()\nreflow small oversized graph",
    fillcolor="#dcfce7",
    mcp_group="Layout"
  ]
  parcel [
    label="_render_encapsulated()\npartition with boundary context",
    fillcolor="#dcfce7",
    mcp_group="Layout"
  ]
  artifacts [
    label="Write SVG + DOT artifacts\n(parent/inner sources when needed)",
    shape=folder,
    fillcolor="#f3e8ff",
    mcp_group="Artifacts"
  ]
  docs [
    label="Markdown\nrequested?",
    shape=diamond,
    fillcolor="#fef3c7",
    mcp_group="Publication"
  ]
  publish [
    label="graphviz_publish_markdown()\nmanaged relative image block",
    fillcolor="#fce7f3",
    mcp_group="Publication"
  ]
  readme [
    label="README.md\nGitHub-rendered diagram",
    shape=note,
    fillcolor="#fce7f3",
    mcp_group="Publication"
  ]
  done [
    label="Done",
    shape=oval,
    fillcolor="#dcfce7",
    mcp_group="Publication"
  ]

  client -> server -> handshake -> request -> source -> entry -> render -> bounds
  bounds -> direct [label="yes"]
  bounds -> reflow [label="small oversized"]
  bounds -> parcel [label="over 25 nodes"]
  direct -> artifacts
  reflow -> artifacts
  parcel -> artifacts
  artifacts -> docs
  docs -> publish [label="yes"]
  docs -> done [label="no"]
  publish -> readme -> done
}